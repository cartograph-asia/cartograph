# Build context for deploy/Dockerfile.api is the repository root.
# The web image uses deploy/Dockerfile.web.dockerignore instead.
.git
.gitignore
.dockerignore
.DS_Store
**/.DS_Store
**/.env
**/.env.*
/deploy
# The static pages' Markdown is embedded into the api (package docs).
/docs/*
!/docs/embed.go
!/docs/PRINCIPLES.md
!/docs/pages
/map
# Only the Pattaya fixture extract goes into the image (for the regions,
# places and seed commands).
/testdata/*
!/testdata/pattaya.osm.gz
!/testdata/pattaya-water.shp
/web
/.claude
/backup
