# Cartograph prototype configuration.
#
#   cp .env.example .env
#
# Every value below is also the built-in default in docker-compose.yml, so the
# stack runs without a .env file. Change secrets before exposing anything.

# --- Host -------------------------------------------------------------------

# Host port of the single entry point (caddy). If you change it, change
# IMG_BASE_URL to match.
HTTP_PORT=8080

# --- PostgreSQL -------------------------------------------------------------

# Superuser, password and database created on first start of the postgres
# volume. Changing them later has no effect until `docker compose down -v`.
POSTGRES_USER=cartograph
POSTGRES_PASSWORD=cartograph
POSTGRES_DB=cartograph

# Connection string used by the api. Must match the three values above.
# Host "postgres" is the compose service name.
DATABASE_URL=postgres://cartograph:cartograph@postgres:5432/cartograph?sslmode=disable

# --- Garage (local S3) ------------------------------------------------------

# Shared secret between Garage nodes: 64 hex characters (openssl rand -hex 32).
GARAGE_RPC_SECRET=dda494800248dc844572c3cb46c426b8ef2b3f1e6b83aa2ab47b47ee5a859c44

# Bearer token for Garage's admin API, used only by garage-init.
GARAGE_ADMIN_TOKEN=PAT5VqzxsIBdt0Y4PsJWopnlIQovuzPVD9jpjV8

# --- Photo storage (any S3-compatible store) --------------------------------

# host[:port] of the S3 endpoint, without scheme. Locally the Garage service.
# Hetzner example: fsn1.your-objectstorage.com
S3_ENDPOINT=garage:3900

# Bucket for photos. garage-init creates it locally with website access,
# which caddy serves read-only under /img/photos/*.
S3_BUCKET=cartograph

# Access key used by the api. Locally garage-init imports this key with
# read/write on S3_BUCKET only. Garage requires the format: access key "GK"
# + 24 hex characters (echo GK$(openssl rand -hex 12)), secret 64 hex
# characters (openssl rand -hex 32).
S3_ACCESS_KEY=GKd530ae12b21f90f857abc4d8
S3_SECRET_KEY=072f12d29227eaaa0abc440478fc241b2680b11feb3f38d6a62b740a57d3eedf

# Region for request signing. Must match s3_region in garage.toml locally.
# Hetzner example: fsn1
S3_REGION=us-east-1

# true = path-style URLs (endpoint/bucket/key), used with Garage locally.
S3_USE_PATH_STYLE=true

# true = HTTPS to the S3 endpoint. false locally, true in production.
S3_USE_SSL=false

# --- api ----------------------------------------------------------------------

# Listen address of the api inside its container. caddy proxies to api:8000.
API_ADDR=:8000

# Public base URL for photos; image URL = IMG_BASE_URL + "/" + object key.
# Locally caddy maps /img/photos/<key> to the Garage bucket (website endpoint).
# Production example: https://cartograph.fsn1.your-objectstorage.com
IMG_BASE_URL=http://localhost:8080/img

# Maximum upload size in megabytes (caddy allows request bodies up to 30 MB).
MAX_UPLOAD_MB=25

# Where the base map's PMTiles archive is served: a path on this site or a
# full URL. Locally caddy serves map/ at /tiles/ (built by map/build.sh). The
# map page and the small maps read it from GET /api/config at run time, so a
# move to a CDN changes only this line. With a CDN, use a dated file name
# (asia-20261101.pmtiles), so that caches never mix two builds.
# Production example: https://tiles.cartograph.asia/asia-20261101.pmtiles
TILES_URL=/tiles/asia.pmtiles

# --- Accounts (magic-link sign-in) -------------------------------------------

# Public origin of the site, without a trailing slash. Magic links point
# here, and an https origin makes the session cookies Secure (__Host- prefix).
# Production: https://cartograph.asia
BASE_URL=http://localhost:8080

# Outgoing mail for sign-in links (net/smtp, STARTTLS required except on
# localhost). Leave SMTP_HOST empty in development: the api then logs each
# link at info level instead of sending it (docker compose logs api).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender of the sign-in e-mails; required when SMTP_HOST is set.
MAIL_FROM=Cartograph.asia <hello@cartograph.asia>

# --- Imports and fixtures (one-shot services regions, places, seed) ----------

# OSM extract, water polygons and clip box for the region and place imports.
# The defaults import the Pattaya fixture baked into the api image. For all of
# Thailand (after map/build.sh; ../map is mounted at /srv/map) use:
#   IMPORT_PBF=/srv/map/data/thailand-latest.osm.pbf
#   IMPORT_WATER=/srv/map/data/sources/water-polygons-split-3857.zip
#   IMPORT_BBOX=
IMPORT_PBF=/usr/share/cartograph/fixtures/pattaya.osm.gz
IMPORT_WATER=/usr/share/cartograph/fixtures/pattaya-water.shp
IMPORT_BBOX=100.82,12.82,100.98,13.02

# Synthetic fixture photos created by the seed service (five example.test
# Surveyors and one featured photo). Prototype only.
SEED_PHOTOS=30
