# Production settings for deploy/compose.prod.yaml (docs/DEPLOY_BRIEF.md).
# Copy to deploy/.env on the host, fill in every value, then chmod 600.
# Never reuse a value from .env.example (the development file): every
# secret below is generated fresh for production, and none goes into git.
#
# Every variable without a value here is required: compose refuses to start
# without it and says which one is missing.

# --- Site -----------------------------------------------------------------

BASE_URL=https://cartograph.asia
# The local port Cartograph's Caddy listens on; the host's Caddy proxies
# cartograph.asia to it (deploy/cartograph.asia.caddy).
HTTP_PORT=

# --- Database -------------------------------------------------------------

# openssl rand -hex 24
POSTGRES_PASSWORD=
# The same password again:
DATABASE_URL=postgres://cartograph:<POSTGRES_PASSWORD>@postgres:5432/cartograph?sslmode=disable

# --- Photos (Garage on the host) ------------------------------------------

# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# The api's key for the bucket: "GK" followed by 24 hex characters, and a
# 64-hex-character secret, e.g.
#   echo "GK$(openssl rand -hex 12)"   and   openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
IMG_BASE_URL=https://cartograph.asia/img

# --- Base map -------------------------------------------------------------

# The archive copied by map/publish.sh, with its build date in the name.
TILES_URL=/tiles/asia-YYYY-MM-DD.pmtiles

# --- Mail (mailbox.org) ---------------------------------------------------

SMTP_HOST=smtp.mailbox.org
SMTP_PORT=587
# The account's primary address (an alias is refused with 535).
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=cartograph.asia <hello@cartograph.asia>

# --- Accounts -------------------------------------------------------------

# Comma-separated; these addresses may use /admin.
ADMIN_EMAILS=
SIGNUP=invite

# --- Crawlers -------------------------------------------------------------

CRAWLERS=block

# --- Limits for a shared host (defaults in compose.prod.yaml) -------------

# UPLOAD_CONCURRENCY=1
# API_MEM_LIMIT=1g
# API_GOMEMLIMIT=768MiB
# POSTGRES_MEM_LIMIT=512m
# GARAGE_MEM_LIMIT=384m
