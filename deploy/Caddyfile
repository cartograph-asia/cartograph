# Front proxy: the single entry point of the prototype (host :8080 -> :80).
#
#   /map, /map/*      -> web:80 (the map page, a Vite build with base /map/)
#   /tiles/*.pmtiles  -> static files from the map/ bind mount (range requests + CORS)
#   /img/photos/<key> -> Garage website endpoint for the bucket (read-only)
#   everything else   -> api:8000 (JSON API under /api/, server-rendered pages)
{
	auto_https off
}

:80 {
	# The token of a magic link (/signin/link?token=…) signs its holder in
	# for up to 15 minutes; it must not reach the access log. Caddy already
	# redacts Cookie headers.
	log {
		format filter {
			request>uri query {
				replace token REDACTED
			}
		}
	}

	handle /api/* {
		# Uploads are capped at MAX_UPLOAD_MB (25) by the api; leave room for
		# multipart overhead.
		request_body {
			max_size 30MB
		}
		reverse_proxy api:8000
	}

	# /map (as linked from the pages, e.g. /map?cell=…) serves the same page
	# as /map/; rewrite keeps the query string. Assets use absolute /map/ paths.
	handle /map {
		rewrite * /map/
		reverse_proxy web:80
	}

	handle /map/* {
		encode zstd gzip
		reverse_proxy web:80
	}

	handle_path /tiles/* {
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Range, If-Match, If-None-Match"
			Access-Control-Expose-Headers "Content-Range, Content-Length, ETag, Accept-Ranges"
		}

		@preflight method OPTIONS
		respond @preflight 204

		# The map/ directory also holds scripts and the OSM extract; only
		# expose the tile archives.
		@notArchive not path *.pmtiles
		respond @notArchive 404

		root * /srv/tiles
		file_server
	}

	handle_path /img/* {
		@readonly method GET HEAD
		handle @readonly {
			# Website access exposes the whole bucket; only photos/ is public.
			@notPhoto not path /photos/*
			respond @notPhoto 404

			# Garage picks the bucket from the Host header (see garage.toml).
			reverse_proxy garage:3902 {
				header_up Host {$S3_BUCKET:cartograph}.web.garage.localhost
				header_up -Authorization
				# Cache-Control comes from the object itself: the api stores
				# photos as "public, max-age=31536000, immutable".
			}
		}
		respond 405
	}

	handle {
		request_body {
			max_size 1MB
		}
		# Pages, feeds and the stylesheet; photos and tiles are not compressed.
		encode zstd gzip
		reverse_proxy api:8000
	}
}
