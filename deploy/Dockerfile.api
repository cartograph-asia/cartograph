# syntax=docker/dockerfile:1
#
# Cartograph api. Build context is the repository root:
#   docker build -f deploy/Dockerfile.api .
#
# h3-go wraps the H3 C library, so this is a cgo build; the final stage is
# distroless/cc (glibc) to match the bookworm build stage.
#
# Besides the api the image carries the one-shot commands import, regions,
# places and seed, plus the Pattaya fixture extract under
# /usr/share/cartograph/fixtures. The importers read OSM PBF through
# paulmach/osm, which links the system zlib (DataDog/czlib); distroless/cc has
# no libz, so it is copied in.
# It goes to /usr/lib/<triplet>: copying to /lib would replace the /lib
# symlink of the image and hide libc.

FROM golang:1.27.3-bookworm AS build
WORKDIR /src
ENV CGO_ENABLED=1 GOFLAGS=-mod=readonly

RUN apt-get update \
 && apt-get install -y --no-install-recommends zlib1g-dev pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && triplet=$(gcc -dumpmachine) \
 && mkdir -p /out/zlib/usr/lib/$triplet \
 && cp -a /usr/lib/$triplet/libz.so.1* /out/zlib/usr/lib/$triplet/

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for c in api import regions places seed; do \
      go build -trimpath -ldflags="-s -w" -o /out/bin/$c ./cmd/$c || exit 1; \
    done

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /out/zlib/ /
COPY --from=build /out/bin/ /usr/local/bin/
COPY testdata/pattaya.osm.gz testdata/pattaya-water.shp /usr/share/cartograph/fixtures/
USER nonroot:nonroot
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/api"]
