<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily pull of the production backups to this Mac (deploy/pull-backups.sh).
     Installed by deploy/install-backup-mac.sh, which fills in @HOME@. A run
     missed while the Mac slept happens when it wakes. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>asia.cartograph.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/cartograph-pull-backups</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/cartograph-backup.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/cartograph-backup.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
