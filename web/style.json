{
  "version": 8,
  "name": "Cartograph paper",
  "metadata": {
    "cartograph:note": "OpenMapTiles-schema style in the page palette (docs/DESIGN_BRIEF.md): land in the paper family, water a pale grey-blue, roads and labels in light slate. The plot layer is drawn on top, so nothing here may be saturated. The source URL is rewritten to an absolute pmtiles://<origin>/tiles/thailand.pmtiles by the frontend."
  },
  "center": [100.5, 13.75],
  "zoom": 6,
  "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles:///tiles/thailand.pmtiles",
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#efe9dd" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "forest"]]],
      "paint": { "fill-color": "#e8e2d2", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "minzoom": 9,
      "paint": { "fill-color": "#e8e2d2", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#d3dce0" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 8,
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d3dce0",
        "line-width": [
          "interpolate", ["exponential", 1.4], ["zoom"],
          8, ["match", ["get", "class"], "river", 0.8, 0.3],
          14, ["match", ["get", "class"], "river", 3, 1]
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#e6dfd1", "fill-outline-color": "#dbd3c3" }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["in", ["get", "class"], ["literal", ["minor", "service"]]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ddd9cf",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.4,
          16, 2.5,
          18, 6
        ]
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d0d0c9",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          9, 0.4,
          14, 1.4,
          18, 8
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#bfc4c3",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          5, 0.3,
          10, 0.9,
          14, 2,
          18, 10
        ]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        ["!=", ["get", "maritime"], 1]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#9aa3a6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 10, 1.2],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "place-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": ["in", ["get", "class"], ["literal", ["village", "suburb", "neighbourhood", "quarter"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 16, 13],
        "text-max-width": 8,
        "symbol-sort-key": ["get", "rank"]
      },
      "paint": {
        "text-color": "#8b9396",
        "text-halo-color": "#efe9dd",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 14, 14],
        "text-max-width": 8,
        "symbol-sort-key": ["get", "rank"]
      },
      "paint": {
        "text-color": "#6f787b",
        "text-halo-color": "#efe9dd",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Medium"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, ["case", ["==", ["get", "capital"], 2], 12, 10],
          10, ["case", ["==", ["get", "capital"], 2], 18, 15]
        ],
        "text-max-width": 8,
        "symbol-sort-key": ["get", "rank"]
      },
      "paint": {
        "text-color": "#4a5559",
        "text-halo-color": "#efe9dd",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 7, 15],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#7c8588",
        "text-halo-color": "#efe9dd",
        "text-halo-width": 1.5
      }
    }
  ]
}
